module corpus.backend.httpstatus;

><salivo.std.core::{outln};

pub enum StatusClass {
    Informational,
    Success,
    Redirection,
    ClientError,
    ServerError,
    Unknown
}

pub struct ResponseStatus {
    int code;
    string reason;
}

pub func classifyStatus(code: int) -> StatusClass {
    let category = code / 100;
    if (category == 2) {
        return StatusClass::Success;
    } else if (category == 3) {
        return StatusClass::Redirection;
    } else if (category == 4) {
        return StatusClass::ClientError;
    } else if (category == 5) {
        return StatusClass::ServerError;
    } else if (category == 1) {
        return StatusClass::Informational;
    }
    return StatusClass::Unknown;
}

pub func statusReason(code: int) -> string {
    return match code {
        200 => "OK",
        201 => "Created",
        204 => "No Content",
        400 => "Bad Request",
        401 => "Unauthorized",
        403 => "Forbidden",
        404 => "Not Found",
        500 => "Internal Server Error",
        502 => "Bad Gateway",
        503 => "Service Unavailable",
        _ => "Unknown Status",
    };
}

pub func main() -> int {
    let test_codes: int = 404;
    let reason = statusReason(test_codes);
    let class_type = classifyStatus(test_codes);

    let class_name = match class_type {
        StatusClass::Success => "Success",
        StatusClass::ClientError => "Client Error",
        StatusClass::ServerError => "Server Error",
        _ => "Other",
    };

    outln($"Status: {test_codes:str} {reason} [{class_name}]");
    return 0;
}
