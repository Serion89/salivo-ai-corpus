module corpus.crypto.http;

><salivo.std.core::{outln};
><salivo.std.collections::{Vec, vecNew, push, get, veclen};

pub struct HttpRequest {
    int method; // 1 = GET, 2 = POST
    int pathId;
    int versionMajor;
}

pub func parseMethod(bytes: Vec<int>) -> int {
    let len = veclen<int>(bytes);
    if (len >= 3) {
        let b0 = get<int>(bytes, 0);
        let b1 = get<int>(bytes, 1);
        let b2 = get<int>(bytes, 2);
        if (b0 == 71 && b1 == 69 && b2 == 84) { // "GET"
            return 1;
        }
    }
    return 0;
}

pub func main() -> int {
    let mut raw: Vec<int> = vecNew<int>();
    raw = push<int>(raw, 71); // 'G'
    raw = push<int>(raw, 69); // 'E'
    raw = push<int>(raw, 84); // 'T'
    let m = parseMethod(raw);
    let req = HttpRequest { method: m, pathId: 1, versionMajor: 1 };
    outln($"HTTP parsed method: {req.method:str} (1=GET)");
    return 0;
}
