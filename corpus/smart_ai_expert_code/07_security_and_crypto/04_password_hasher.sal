module corpus.security.hasher;

><salivo.std.core::{outln};
><salivo.std.crypto::{sha256Hex, constantTimeEq};

pub struct StoredCredential {
    string username;
    string salt;
    string password_hash;
}

pub func hashPassword(password: string, salt: string) -> string {
    let combined = $"{salt}${password}";
    return sha256Hex(combined);
}

pub func verifyPassword(cred: StoredCredential, attempt: string) -> bool {
    let computed_hash = hashPassword(attempt, cred.salt);
    return constantTimeEq(computed_hash, cred.password_hash);
}

pub func main() -> int {
    let salt = "r4nd0m_s4lt_9921";
    let stored_pw = "CorrectBatteryStaple!";
    let hashed = hashPassword(stored_pw, salt);

    let user_cred = StoredCredential {
        username: "security_admin",
        salt: salt,
        password_hash: hashed,
    };

    let check_ok = verifyPassword(user_cred, "CorrectBatteryStaple!");
    let check_fail = verifyPassword(user_cred, "WrongPassword");

    if (check_ok) {
        outln("Valid password authentication: SUCCESS");
    } else {
        outln("Valid password authentication: FAILED");
    }

    if (!check_fail) {
        outln("Invalid password rejection: SUCCESS");
    } else {
        outln("Invalid password rejection: FAILED");
    }

    return 0;
}
