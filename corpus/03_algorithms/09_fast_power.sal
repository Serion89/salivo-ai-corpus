module corpus.algorithms.fastpower;

><salivo.std.core::{outln};

pub func modPow(base_val: int, exp_val: int, modulus: int) -> int {
    if (modulus == 1) {
        return 0;
    }

    let mut result: int = 1;
    let mut base_acc: int = base_val % modulus;
    let mut current_exp: int = exp_val;

    while (current_exp > 0) {
        if (current_exp % 2 == 1) {
            result = (result * base_acc) % modulus;
        }
        current_exp = current_exp / 2;
        base_acc = (base_acc * base_acc) % modulus;
    }

    return result;
}

pub func main() -> int {
    // 2^10 mod 1000 = 1024 mod 1000 = 24
    let res1 = modPow(2, 10, 1000);
    // 3^7 mod 13 = 2187 mod 13 = 3
    let res2 = modPow(3, 7, 13);

    outln($"2^10 mod 1000 = {res1:str}");
    outln($"3^7 mod 13 = {res2:str}");

    return 0;
}
