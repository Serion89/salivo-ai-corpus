module corpus.gen.frontend.card_113;
><salivo.std.core::{outln};

pub struct Card { string title; int likes; }

pub func main() -> int {
    let c = Card { title: "Post 113", likes: 339 };
    let html = $"<div class='card'><h3>{c.title}</h3><span>{c.likes:str} likes</span></div>";
    outln(html);
    return 0;
}
